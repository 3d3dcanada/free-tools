# Optional. Nothing here is required to build or run the tools.

# Where the "Feedback" form on each tool and the lesson correction form post to.
# Empty (the default) hides both forms and sends nothing anywhere.
# The endpoint receives one multipart POST with a `payload` field (JSON) and must answer
# { "ref": "<receipt>" } to confirm it took the message.
VITE_FEEDBACK_ENDPOINT=

# A Cloudflare Turnstile site key, only if your feedback endpoint verifies tokens.
# Empty: the forms skip the human check and send the placeholder token "no-check".
VITE_TURNSTILE_SITE_KEY=
